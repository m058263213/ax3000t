#!/bin/sh
# MOGIKANIN first-boot defaults: selective VPN (Xray TUN xray0) + hardening.
# Runs once on first boot. If the router already has this setup (kept settings after sysupgrade), only the theme is set.

THEME='/luci-static/footstrap'
[ -n "$THEME" ] && { uci set luci.main.mediaurlbase="$THEME"; uci commit luci; }

[ -n "$(uci -q get network.xvpn)" ] && exit 0

# --- system ---
uci set system.@system[0].hostname='MOGIKANIN'
uci set system.@system[0].zonename='Europe/Moscow'
uci set system.@system[0].timezone='MSK-3'
uci commit system

# --- network: LAN 192.168.31.1, IPv6 off, xray0 interface, policy routing ---
uci -q delete network.lan.ipaddr
uci -q delete network.lan.netmask
uci add_list network.lan.ipaddr='192.168.31.1/24'
uci -q delete network.wan6
uci -q delete network.lan.ip6assign
uci -q delete network.globals.ula_prefix
uci set network.wan.ipv6='0'
uci set network.xvpn=interface
uci set network.xvpn.proto='none'
uci set network.xvpn.device='xray0'
uci set network.xray_route=route
uci set network.xray_route.interface='xvpn'
uci set network.xray_route.target='0.0.0.0/0'
uci set network.xray_route.table='100'
uci set network.xray_rule=rule
uci set network.xray_rule.mark='0x100'
uci set network.xray_rule.in='lan'
uci set network.xray_rule.lookup='100'
uci commit network

# --- firewall ---
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='0'
for i in $(uci show firewall | grep -E "\.name='(Allow-IPSec-ESP|Allow-ISAKMP)'" | cut -d. -f2 | sort -r); do uci delete firewall.$i; done
uci set firewall.vpn_domains=ipset
uci set firewall.vpn_domains.name='vpn_domains'
uci set firewall.vpn_domains.family='ipv4'
uci add_list firewall.vpn_domains.match='dest_ip'
uci set firewall.vpn_static=ipset
uci set firewall.vpn_static.name='vpn_static'
uci set firewall.vpn_static.family='ipv4'
uci add_list firewall.vpn_static.match='dest_net'
uci set firewall.zone_vpn=zone
uci set firewall.zone_vpn.name='vpn'
uci add_list firewall.zone_vpn.network='xvpn'
uci set firewall.zone_vpn.input='REJECT'
uci set firewall.zone_vpn.output='ACCEPT'
uci set firewall.zone_vpn.forward='REJECT'
uci set firewall.fwd_lan_vpn=forwarding
uci set firewall.fwd_lan_vpn.src='lan'
uci set firewall.fwd_lan_vpn.dest='vpn'
uci set firewall.force_dns=redirect
uci set firewall.force_dns.name='Force-LAN-DNS'
uci set firewall.force_dns.src='lan'
uci set firewall.force_dns.proto='tcp udp'
uci set firewall.force_dns.src_dport='53'
uci set firewall.force_dns.target='DNAT'
uci set firewall.force_dns.family='ipv4'
uci set firewall.block_dot=rule
uci set firewall.block_dot.name='Block-DoT'
uci set firewall.block_dot.src='lan'
uci set firewall.block_dot.dest='wan'
uci set firewall.block_dot.proto='tcp udp'
uci set firewall.block_dot.dest_port='853'
uci set firewall.block_dot.target='REJECT'
uci commit firewall

# --- dhcp / dns ---
D=$(uci show dhcp | grep -m1 '=dnsmasq' | cut -d= -f1 | cut -d. -f2)
uci set dhcp.$D.filter_aaaa='1'
uci set dhcp.$D.rebind_protection='1'
uci set dhcp.$D.rebind_localhost='1'
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci -q delete dhcp.lan.ra_flags
uci set dhcp.vpn_domains=ipset
uci add_list dhcp.vpn_domains.name='vpn_domains'
uci set dhcp.vpn_domains.table='fw4'
uci set dhcp.vpn_domains.table_family='inet'
uci commit dhcp
NORESTART=1 /usr/bin/xvpn apply-lists >/dev/null 2>&1
/etc/init.d/odhcpd disable 2>/dev/null
# xl2tpd: off until the wizard selects L2TP (netifd also starts it on demand)
[ -n "$(uci -q get network.wanl2tp)" ] || /etc/init.d/xl2tpd disable 2>/dev/null

# --- SSH: port 10122, LAN only, keys only (add a key in LuCI: System > Administration > SSH-Keys) ---
uci set dropbear.main.Port='10122'
uci set dropbear.main.Interface='lan'
uci set dropbear.main.PasswordAuth='off'
uci set dropbear.main.RootPasswordAuth='off'
uci commit dropbear

# --- LuCI: HTTP only (no self-signed HTTPS); WAN access is blocked by the firewall (wan input REJECT) ---
uci -q delete uhttpd.main.listen_http
uci -q delete uhttpd.main.listen_https
uci add_list uhttpd.main.listen_http='0.0.0.0:80'
uci set uhttpd.main.redirect_https='0'
uci commit uhttpd

# --- Wi-Fi: name and WPA2/WPA3; stays OFF until a password is set (LuCI: Network > Wireless) or a backup is restored ---
for r in default_radio0 default_radio1; do
	uci -q get wireless.$r >/dev/null || continue
	uci set wireless.$r.ssid='mogikanin'
	uci set wireless.$r.encryption='sae-mixed'
done
uci -q commit wireless

# --- Xray: enabled by the VPN page after a link is saved ---
uci set xray.enabled.enabled='0'
uci -q delete xray.config.confdir
uci commit xray

touch /etc/config/xvpn; uci set xvpn.setup=setup; uci set xvpn.setup.done='0'; uci commit xvpn

grep -qx '/etc/xray/' /etc/sysupgrade.conf || echo '/etc/xray/' >> /etc/sysupgrade.conf
exit 0
